flowchart LR
  C1["Email inbox"] --> G
  C2["Watched folder"] --> G
  C3["Upload portal"] --> G
  C4["API"] --> G
  G["Tenant · identity · consent gateway"] --> S["Document Operations Agent"]
  S --> R["Retrieve permitted context"]
  R --> P["Policy and confidence check"]
  P -->|read only| T["Typed tool adapters"]
  P -->|consequential| H["Human approval"]
  H --> T
  T --> V["Verify external state"]
  V --> E["Receipt · outcome · audit"]
  E --> M["MNEMA verified memory"]
  X1["Document parsing: UnboundPDF + Docling"]
  X2["OCR: PaddleOCR or Tesseract"]
  X3["Storage: S3-compatible encrypted storage"]
  X4["Business system: Existing ERP/CRM/DMS"]
  T <--> X1
  T <--> X2
  T <--> X3
  T <--> X4

  classDef agent fill:#2457ff,color:#fff,stroke:#2457ff;
  classDef human fill:#c8ff4d,color:#151515,stroke:#151515;
  class S agent;
  class H human;
