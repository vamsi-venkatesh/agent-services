    {
      "id": "f3356e87-46fd-4c08-a0c6-d3b35cb9bb06",
      "runId": "37c494ba-14b8-40ec-b262-1f006ac7235e",
      "lane": "mock",
      "kind": "gate",
      "status": "resolved",
      "summary": "Decision gate — “Is every required field on this document validated against something outside it — and can the write it would trigger be undone?” → Queue for human review: a required field is unvalidated, the totals do not reconcile, or a payment detail changed.",
      "detail": {
        "gateId": "document-boundary",
        "question": "Is every required field on this document validated against something outside it — and can the write it would trigger be undone?",
        "outcomes": [
          "Write the validated record: every required field validated externally and the write can be undone",
          "Hold as a suspected duplicate: the document number or the file checksum matches one already processed",
          "Return to intake: the document cannot be parsed to its required fields, or matches no known type",
          "Queue for human review: a required field is unvalidated, the totals do not reconcile, or a payment detail changed",
          "Prepare and hold for the named approver: the write cannot be undone"
        ],
        "outcome": "Queue for human review: a required field is unvalidated, the totals do not reconcile, or a payment detail changed",
        "pathId": "path-review",
        "decidedBy": "Condition (3) of the document boundary, matched three times over. The gross figure does not equal net plus tax, so the arithmetic check that does not depend on any read confidence has failed. Two invoice lines have no counterpart on the purchase order. And the bank account printed on the invoice differs from the account on the supplier master record — which goes to a human regardless of confidence, because a forged payment instruction is usually rendered more cleanly than a genuine scan, and this is the one field where an accurate read of the wrong value moves money.",
